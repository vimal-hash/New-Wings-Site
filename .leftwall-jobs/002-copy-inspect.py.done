import os, shutil, hashlib, subprocess, bpy
W=r"D:\CodexOutputs\Theatre_LeftWall_Bake_20261023"; os.makedirs(W,exist_ok=True)
src=r"D:\CodexOutputs\Theatre_Optimization_20261017\Theatre_Moon_Projector_optimized.blend"
def sha(p):
    h=hashlib.sha256()
    with open(p,'rb') as f:
        for b in iter(lambda:f.read(1<<24),b''):h.update(b)
    return h.hexdigest()
dst=os.path.join(W,"LeftWall_work_copy.blend")
if not os.path.exists(dst): shutil.copy2(src,dst)
print("SRC_SHA",sha(src)); print("COPY_SHA",sha(dst))
log=open(os.path.join(W,"inspect.log"),"w")
subprocess.Popen([bpy.app.binary_path,"-b",dst,"--python",r"D:\New folio\new site code\new_site_three\scripts\blender\left-wall\inspect-left-wall.py"],stdout=log,stderr=subprocess.STDOUT)
print("LAUNCHED")
